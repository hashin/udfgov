---
layout: base.njk
ogType: profile
---
{% set allMyInitiatives = collections.initiatives | byMinister(page.fileSlug) %}
{% set myInitiatives = allMyInitiatives | slice(0, 9) %}
{% if photo %}
{% set personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": name,
  "jobTitle": designation,
  "affiliation": { "@type": "GovernmentOrganization", "name": site.title },
  "image": site.url + photo,
  "url": site.url + page.url
} %}
{% else %}
{% set personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": name,
  "jobTitle": designation,
  "affiliation": { "@type": "GovernmentOrganization", "name": site.title },
  "url": site.url + page.url
} %}
{% endif %}
<script type="application/ld+json">{{ personSchema | dump | safe }}</script>
<article class="minister-profile">
  <div class="minister-header">
    {% if photo %}
      {% responsiveImage photo, name, [140, 280], "140px", "eager", "minister-photo" %}
    {% else %}
      <div class="minister-photo minister-photo-placeholder" aria-hidden="true">{{ name | initials }}</div>
    {% endif %}
    <div class="minister-header-text">
      <span class="tag">{{ designation }}</span>
      <h1>{{ name }}</h1>
      {% if portfolios %}<p class="minister-portfolios">{{ portfolios }}</p>{% endif %}
      <p class="minister-meta">
        {% if party %}{{ party }}{% endif %}{% if party and constituency %} &middot; {% endif %}{% if constituency %}{{ constituency }}{% endif %}
      </p>
    </div>
  </div>

  <section class="minister-initiatives">
    <h2>Initiatives &amp; announcements</h2>
    {% if myInitiatives.length %}
    <div class="grid">
      {% for item in myInitiatives %}
      <a class="card" href="{{ item.url }}">
        <div class="card-image">
          {% responsiveImage item.data.poster, item.data.title, [340, 680], "(min-width: 1080px) 331px, (min-width: 600px) 45vw, 92vw", "lazy" %}
        </div>
        <div class="card-body">
          {% if item.data.category %}<span class="tag">{{ item.data.category }}</span>{% endif %}
          <h2>{{ item.data.title }}</h2>
          {% if item.data.date %}<time datetime="{{ item.data.date | isoDate }}">{{ item.data.date | readableDate }}</time>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
    {% if allMyInitiatives.length > myInitiatives.length %}
    <div class="see-more-wrap">
      <a class="see-more-btn" href="/ministers/{{ page.fileSlug }}/page/2/">See more initiatives &rarr;</a>
    </div>
    {% endif %}
    {% else %}
    <p class="empty-state">No initiatives linked to {{ name }} yet.</p>
    {% endif %}
  </section>

  <p class="back-link"><a href="/ministers/">&larr; All ministers</a></p>
</article>
