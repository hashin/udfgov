<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{% if site.gaId and not draft %}
{# Google Analytics (GA4). ID comes from the GA_MEASUREMENT_ID env var --
   see docs/SETUP.md. Skipped entirely on draft pages so review previews
   don't pollute traffic data. #}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}', {
    {% if ogType == "article" %}
    content_type: "initiative",
    {% if category %}content_category: {{ category | dump | safe }},{% endif %}
    {% if ministry %}content_ministry: {{ ministry | dump | safe }},{% endif %}
    {% if minister %}content_minister: {{ minister | dump | safe }},{% endif %}
    {% elif ogType == "profile" %}
    content_type: "minister_profile",
    {% endif %}
  });
</script>
{% endif %}

<title>{{ title }}{% if title != site.title %} · {{ site.title }}{% endif %}</title>
{% set pageDescription = description or summary or site.tagline %}
{% set pageImage = image or poster or site.defaultImage %}
<meta name="description" content="{{ pageDescription }}">
{% if draft %}<meta name="robots" content="noindex, nofollow">{% endif %}

{# Open Graph / WhatsApp / Facebook link-preview tags — must use absolute URLs #}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ pageImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

{# Twitter/X card #}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ site.url }}{{ pageImage }}">

<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/static/images/favicon.png">
<link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand-mark">UDF</span>
      <span class="brand-text">{{ site.title }}</span>
    </a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/archive/">Archive</a>
      <a href="/ministers/">Ministers</a>
      <a href="/about/">About</a>
    </nav>
  </header>

  {% if draft %}
  <div class="draft-banner">Draft — not shown in public listings. Uncheck "Draft" in the CMS to publish.</div>
  {% endif %}

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {% year %} {{ site.title }}. Built to document the work of the UDF Government of Kerala.</p>
  </footer>
</body>
</html>
