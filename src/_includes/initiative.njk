---
layout: base.njk
ogType: article
---
<article class="initiative">
  <div class="hero">
    <img class="hero-image" src="{{ poster }}" alt="{{ title }}" loading="eager">
  </div>

  <div class="initiative-body">
    <div class="initiative-meta">
      {% if category %}<a class="tag tag-link" href="/category/{{ category | lower }}/">{{ category }}</a>{% endif %}
      {% if date %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}
    </div>

    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}

    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="share-bar">
      <span class="share-label">Share this</span>
      <a class="share-btn whatsapp" data-share-method="whatsapp" target="_blank" rel="noopener"
         href="https://wa.me/?text={{ title | shareText(summary, site.url + page.url) | urlencode }}">WhatsApp</a>
      <a class="share-btn twitter" data-share-method="twitter" target="_blank" rel="noopener"
         href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ (site.url + page.url) | urlencode }}">X</a>
      <a class="share-btn facebook" data-share-method="facebook" target="_blank" rel="noopener"
         href="https://www.facebook.com/sharer/sharer.php?u={{ (site.url + page.url) | urlencode }}&quote={{ title | shareText(summary) | urlencode }}">Facebook</a>
      <button class="share-btn copy" data-share-method="copy_link" type="button" data-copy-url="{{ site.url }}{{ page.url }}">Copy link</button>
    </div>
  </div>
</article>

<script>
document.querySelectorAll('[data-share-method]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    if (typeof gtag === 'function') {
      gtag('event', 'share', {
        method: btn.getAttribute('data-share-method'),
        content_type: 'initiative',
        item_id: {{ page.fileSlug | dump | safe }}
      });
    }
  });
});

document.querySelectorAll('[data-copy-url]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    navigator.clipboard.writeText(btn.getAttribute('data-copy-url')).then(function () {
      var original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = original; }, 1500);
    });
  });
});
</script>
