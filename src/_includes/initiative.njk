---
layout: base.njk
ogType: article
---
{% from "share-bar.njk" import render as shareBar %}
{% set articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "image": [site.url + poster],
  "datePublished": date | isoDate,
  "author": { "@type": "GovernmentOrganization", "name": site.title },
  "publisher": {
    "@type": "GovernmentOrganization",
    "name": site.title,
    "logo": { "@type": "ImageObject", "url": site.url + site.logo }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": site.url + page.url },
  "description": summary,
  "articleSection": category,
  "inLanguage": "ml"
} %}
<script type="application/ld+json">{{ articleSchema | dump | safe }}</script>
<article class="initiative">
  <div class="hero">
    {% responsiveImage poster, title, 1200, "eager", "hero-image" %}
  </div>

  <div class="initiative-body" lang="ml">
    <div class="initiative-meta">
      {% if category %}<a class="tag tag-link" href="/category/{{ category | lower }}/" lang="en">{{ category }}</a>{% endif %}
      {% if date %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}
    </div>

    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}

    <div class="prose">
      {{ content | safe }}
    </div>

    <div lang="en">
      {{ shareBar(title, summary, site.url + page.url, site.url + poster, 'initiative', page.fileSlug, site.whatsappChannelPromo) }}
    </div>
  </div>
</article>
