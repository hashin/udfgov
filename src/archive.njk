---
layout: base.njk
title: Archive — UDF Kerala
description: Browse UDF Kerala initiatives by year or by ministry.
---
<section class="hero-banner">
  <h1>Archive</h1>
  <p>Browse every initiative by year or by ministry.</p>
</section>

<section class="archive-section">
  <h2>By date</h2>
  {% if collections.initiativesByYear.length %}
  <ul class="archive-list archive-index-list">
    {% for yearGroup in collections.initiativesByYear %}
    <li><a href="/archive/{{ yearGroup.year }}/">{{ yearGroup.year }}</a> <span class="archive-count">({{ yearGroup.total }})</span></li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-state">No initiatives published yet.</p>
  {% endif %}
</section>

<section class="archive-section">
  <h2>By ministry</h2>
  <ul class="archive-list archive-index-list">
    {% for group in collections.ministryArchive %}
    <li><a href="/archive/ministry/{{ group.slug }}/">{{ group.ministry }}</a> <span class="archive-count">({{ group.items.length }})</span></li>
    {% endfor %}
  </ul>
</section>

<p class="archive-more-link"><a href="/ministers/">Browse by minister &rarr;</a></p>
