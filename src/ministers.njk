---
layout: base.njk
title: Council of Ministers — UDF Kerala
description: The UDF Government of Kerala's Council of Ministers and their portfolios.
---
<section class="hero-banner">
  <h1>Council of Ministers</h1>
  <p>The UDF Government of Kerala's ministers and their portfolios.</p>
</section>

<section id="ministers" class="grid minister-grid">
  {% for m in collections.ministers %}
  <a class="card minister-card" href="{{ m.url }}">
    {% if m.data.photo %}
      <img class="minister-card-photo" src="{{ m.data.photo }}" alt="{{ m.data.name }}" loading="lazy">
    {% else %}
      <div class="minister-card-photo minister-photo-placeholder" aria-hidden="true">{{ m.data.name | initials }}</div>
    {% endif %}
    <div class="card-body">
      <span class="tag">{{ m.data.designation }}</span>
      <h2>{{ m.data.name }}</h2>
      {% if m.data.portfolios %}<p>{{ m.data.portfolios }}</p>{% endif %}
    </div>
  </a>
  {% endfor %}
</section>
